const API_BASE = import.meta.env.VITE_API_URL || 'http://localhost:3000';

async function request<T>(
  path: string,
  options?: RequestInit & { isFormData?: boolean },
): Promise<T> {
  const headers: Record<string, string> = {};

  if (!options?.isFormData) {
    headers['Content-Type'] = 'application/json';
  }

  const res = await fetch(`${API_BASE}${path}`, {
    ...options,
    credentials: 'include',
    headers: {
      ...headers,
      ...(options?.headers as Record<string, string> || {}),
    },
  });

  if (!res.ok) {
    const err = await res.json().catch(() => ({ message: res.statusText }));
    throw new Error(err.message || 'Request failed');
  }

  return res.json();
}

export const api = {
  portfolio: {
    create: (body: {
      title: string;
      description: string;
      projectUrl?: string;
      githubUrl?: string;
      demoUrl?: string;
      technologies: string[];
      role?: string;
      startDate?: string;
      endDate?: string;
      isPublic?: boolean;
    }) => request<Portfolio>('/api/portfolio', {
      method: 'POST',
      body: JSON.stringify(body),
    }),

    list: () => request<Portfolio[]>('/api/portfolio'),

    get: (id: string) => request<Portfolio>(`/api/portfolio/${id}`),

    update: (id: string, body: Partial<{
      title: string;
      description: string;
      projectUrl?: string;
      githubUrl?: string;
      demoUrl?: string;
      technologies: string[];
      role?: string;
      startDate?: string;
      endDate?: string;
      isPublic?: boolean;
    }>) => request<Portfolio>(`/api/portfolio/${id}`, {
      method: 'PATCH',
      body: JSON.stringify(body),
    }),

    delete: (id: string) => request<void>(`/api/portfolio/${id}`, { method: 'DELETE' }),
  },

  resumes: {
    create: (formData: FormData) =>
      request<Resume>('/api/resumes', {
        method: 'POST',
        body: formData,
        isFormData: true,
      }),

    list: () => request<Resume[]>('/api/resumes'),

    get: (id: string) => request<Resume>(`/api/resumes/${id}`),

    delete: (id: string) =>
      request<void>(`/api/resumes/${id}`, { method: 'DELETE' }),

    analyze: (id: string) =>
      request<Resume>(`/api/resumes/${id}/analyze`, { method: 'POST' }),

    coverLetter: (
      id: string,
      body: {
        companyName: string;
        hiringManager?: string;
        additionalContext?: string;
      },
    ) =>
      request<CoverLetter>(`/api/resumes/${id}/cover-letter`, {
        method: 'POST',
        body: JSON.stringify(body),
      }),

    skillGap: (id: string, body: { jobDescription?: string }) =>
      request<SkillGapResult>(`/api/resumes/${id}/skill-gap`, {
        method: 'POST',
        body: JSON.stringify(body),
      }),

    interviewQuestions: (
      id: string,
      body: {
        jobDescription?: string;
        questionCount?: number;
        focusAreas?: string;
      },
    ) =>
      request<InterviewQuestionsResult>(
        `/api/resumes/${id}/interview-questions`,
        {
          method: 'POST',
          body: JSON.stringify(body),
        },
      ),

    salaryEstimate: (
      id: string,
      body: {
        targetLocation?: string;
        yearsOfExperience?: string;
        targetIndustry?: string;
      },
    ) =>
      request<SalaryRangeResult>(`/api/resumes/${id}/salary-estimate`, {
        method: 'POST',
        body: JSON.stringify(body),
      }),

    multiJd: (id: string, body: { jobEntries: { title: string; description: string }[] }) =>
      request<MultiJdResult>(`/api/resumes/${id}/multi-jd`, {
        method: 'POST',
        body: JSON.stringify(body),
      }),

    templateSuggestions: (id: string) =>
      request<ResumeTemplateSuggestionsResult>(`/api/resumes/${id}/template-suggestions`, {
        method: 'POST',
      }),

    getSkillGap: (id: string) =>
      request<SkillGapResult | null>(`/api/resumes/${id}/skill-gap`),

    getInterviewQuestions: (id: string) =>
      request<InterviewQuestionsResult | null>(`/api/resumes/${id}/interview-questions`),

    getSalaryEstimate: (id: string) =>
      request<SalaryRangeResult | null>(`/api/resumes/${id}/salary-estimate`),

    getTemplateSuggestions: (id: string) =>
      request<ResumeTemplateSuggestionsResult | null>(`/api/resumes/${id}/template-suggestions`),

    getTailoredResume: (id: string) =>
      request<TailoredResumeResult | null>(`/api/resumes/${id}/tailored-resume`),

    generateTailoredResume: (
      id: string,
      body: { jobDescription: string; targetRole?: string },
    ) =>
      request<TailoredResumeResult>(`/api/resumes/${id}/tailored-resume`, {
        method: 'POST',
        body: JSON.stringify(body),
      }),

    // Resume Version Management
    createResumeVersion: (
      id: string,
      body: { name: string; description?: string; content: any; isPrimary?: boolean },
    ) =>
      request<ResumeVersion>(`/api/resumes/${id}/versions`, {
        method: 'POST',
        body: JSON.stringify(body),
      }),

    getResumeVersions: (id: string) =>
      request<ResumeVersion[]>(`/api/resumes/${id}/versions`),

    getResumeVersion: (versionId: string) =>
      request<ResumeVersion>(`/api/resumes/version/${versionId}`),

    updateResumeVersion: (
      versionId: string,
      body: { name?: string; description?: string; content?: any; isPrimary?: boolean },
    ) =>
      request<ResumeVersion>(`/api/resumes/version/${versionId}`, {
        method: 'PATCH',
        body: JSON.stringify(body),
      }),

    deleteResumeVersion: (versionId: string) =>
      request<void>(`/api/resumes/version/${versionId}`, {
        method: 'DELETE',
      }),

    setPrimaryResumeVersion: (versionId: string) =>
      request<ResumeVersion>(`/api/resumes/version/${versionId}/primary`, {
        method: 'PATCH',
      }),

    getMultiJd: (id: string) =>
      request<MultiJdResult | null>(`/api/resumes/${id}/multi-jd`),

    getLatestCoverLetter: (id: string) =>
      request<CoverLetter | null>(`/api/resumes/${id}/cover-letters/latest`),

    getTipFeedback: (id: string) =>
      request<TipFeedback>(`/api/resumes/${id}/tip-feedback`),

    saveTipFeedback: (id: string, key: string, value: 'up' | 'down' | null) =>
      request<TipFeedback>(`/api/resumes/${id}/tip-feedback`, {
        method: 'POST',
        body: JSON.stringify({ key, value }),
      }),

    generateShareLink: (id: string) =>
      request<{ token: string }>(`/api/resumes/${id}/share`, { method: 'POST' }),

    updateStatus: (id: string, status: string, notes?: string) =>
        request<Resume>(`/api/resumes/${id}/status`, {
          method: 'PATCH',
          body: JSON.stringify({ status, notes }),
        }),
    },

    linkedin: {
      analyze: (body: { profileText: string; profileUrl?: string; targetRole?: string }) =>
        request<LinkedInProfile>('/api/linkedin/analyze', {
          method: 'POST',
          body: JSON.stringify(body),
        }),

      list: () => request<LinkedInProfileListItem[]>('/api/linkedin/profiles'),

      get: (id: string) => request<LinkedInProfile>(`/api/linkedin/profiles/${id}`),

      delete: (id: string) => request<void>(`/api/linkedin/profiles/${id}`, { method: 'DELETE' }),

      reanalyze: (id: string, body?: { targetRole?: string }) =>
        request<LinkedInProfile>(`/api/linkedin/profiles/${id}/reanalyze`, {
          method: 'POST',
          body: JSON.stringify(body),
        }),
    },

    share: {
    getReport: (token: string) =>
      request<SharedReport>(`/api/share/${token}`),
  },

  batches: {
    create: (formData: FormData) =>
      request<Batch>('/api/batches', {
        method: 'POST',
        body: formData,
        isFormData: true,
      }),

    get: (id: string) =>
      request<Batch & { resumes: Resume[] }>(`/api/batches/${id}`),
  },

  jobs: {
    search: (params: {
      keywords?: string[];
      location?: string;
      jobTypes?: string[];
      remoteTypes?: string[];
      experienceLevels?: string[];
      sources?: string[];
      page?: number;
      limit?: number;
    }) => {
      const searchParams = new URLSearchParams();
      if (params.keywords) searchParams.set('keywords', params.keywords.join(','));
      if (params.location) searchParams.set('location', params.location);
      if (params.jobTypes) searchParams.set('jobTypes', params.jobTypes.join(','));
      if (params.remoteTypes) searchParams.set('remoteTypes', params.remoteTypes.join(','));
      if (params.experienceLevels) searchParams.set('experienceLevels', params.experienceLevels.join(','));
      if (params.sources) searchParams.set('sources', params.sources.join(','));
      if (params.page) searchParams.set('page', params.page.toString());
      if (params.limit) searchParams.set('limit', params.limit.toString());
      return request<JobSearchResult>(`/api/jobs/search?${searchParams.toString()}`);
    },

    list: (filters?: {
      source?: string;
      isBookmarked?: boolean;
      search?: string;
      jobType?: string;
      remoteType?: string;
      experienceLevel?: string;
      page?: number;
      limit?: number;
    }) => {
      const searchParams = new URLSearchParams();
      if (filters?.source) searchParams.set('source', filters.source);
      if (filters?.isBookmarked !== undefined) searchParams.set('bookmarked', filters.isBookmarked.toString());
      if (filters?.search) searchParams.set('search', filters.search);
      if (filters?.jobType) searchParams.set('jobType', filters.jobType);
      if (filters?.remoteType) searchParams.set('remoteType', filters.remoteType);
      if (filters?.experienceLevel) searchParams.set('experienceLevel', filters.experienceLevel);
      if (filters?.page) searchParams.set('page', filters.page.toString());
      if (filters?.limit) searchParams.set('limit', filters.limit.toString());
      return request<JobListResult>(`/api/jobs?${searchParams.toString()}`);
    },

    get: (id: string) => request<Job>(`/api/jobs/${id}`),

    toggleBookmark: (id: string) =>
      request<Job>(`/api/jobs/${id}/bookmark`, { method: 'PATCH' }),

    addTags: (id: string, tags: string[]) =>
      request<Job>(`/api/jobs/${id}/tags`, { method: 'POST', body: JSON.stringify({ tags }) }),

    removeTag: (id: string, tag: string) =>
      request<Job>(`/api/jobs/${id}/tags/${tag}`, { method: 'DELETE' }),

    markAsApplied: (id: string) =>
      request<Job>(`/api/jobs/${id}/apply`, { method: 'POST' }),

    analyzeMatch: (jobId: string, resumeId: string) =>
          request<JobMatchResult>(`/api/jobs/${jobId}/match`, {
            method: 'POST',
            body: JSON.stringify({ resumeId }),
          }),

        batchMatch: (resumeId: string, jobIds: string[]) =>
          request<JobMatchResult[]>(`/api/jobs/batch-match`, {
            method: 'POST',
            body: JSON.stringify({ resumeId, jobIds }),
          }),

        savedSearches: {
      create: (data: {
        name: string;
        keywords: string[];
        location?: string;
        jobTypes?: string[];
        remoteTypes?: string[];
        experienceLevels?: string[];
        sources?: string[];
      }) =>
        request<SavedSearch>('/api/jobs/searches', {
          method: 'POST',
          body: JSON.stringify(data),
        }),

      list: () => request<SavedSearch[]>('/api/jobs/searches'),

      update: (id: string, data: Partial<{
        name: string;
        keywords: string[];
        location?: string;
        jobTypes?: string[];
        remoteTypes?: string[];
        experienceLevels?: string[];
        sources?: string[];
        isActive: boolean;
      }>) =>
        request<SavedSearch>(`/api/jobs/searches/${id}`, {
          method: 'PATCH',
          body: JSON.stringify(data),
        }),

      delete: (id: string) =>
        request<void>(`/api/jobs/searches/${id}`, { method: 'DELETE' }),

      run: (id: string) =>
        request<Job[]>(`/api/jobs/searches/${id}/run`, { method: 'POST' }),
    },
  },
};

export function getUploadUrl(path: string): string {
  return `${API_BASE}/uploads/${path}`;
}